import math
import random
import time
import numpy as np
import matplotlib.pyplot as plt

# Dán toàn bộ nội dung file .tsp (a280, att532, d1291, berlin52,...) vào giữa cặp dấu """ và """
TSP_DATA = """

"""


def build_universal_data(raw_text):
    name = "Unknown"
    dimension = None
    edge_type = "EUC_2D"
    edge_format = "FULL_MATRIX"
    section = None
    coords = []
    explicit_weights = []

    for line in raw_text.strip().splitlines():
        line = line.strip()
        if not line:
            continue
        if line == "EOF":
            break

        if ":" in line and section is None:
            key, val = [x.strip() for x in line.split(":", 1)]
            if key == "NAME":
                name = val
            elif key == "DIMENSION":
                dimension = int(val)
            elif key == "EDGE_WEIGHT_TYPE":
                edge_type = val
            elif key == "EDGE_WEIGHT_FORMAT":
                edge_format = val
            continue

        if line in ("NODE_COORD_SECTION", "EDGE_WEIGHT_SECTION", "DISPLAY_DATA_SECTION"):
            section = line
            continue

        if section in ("NODE_COORD_SECTION", "DISPLAY_DATA_SECTION"):
            parts = line.split()
            if len(parts) >= 3:
                coords.append((float(parts[1]), float(parts[2])))
        elif section == "EDGE_WEIGHT_SECTION":
            explicit_weights.extend(float(x) for x in line.split())
        elif section is None:
            parts = line.split()
            try:
                if len(parts) >= 3:
                    coords.append((float(parts[1]), float(parts[2])))
                elif len(parts) == 2:
                    coords.append((float(parts[0]), float(parts[1])))
            except ValueError:
                pass

    if edge_type == "EXPLICIT":
        n = dimension
        dist = np.zeros((n, n), dtype=np.int32)
        idx = 0

        if edge_format == "FULL_MATRIX":
            dist = np.array(explicit_weights[: n * n], dtype=np.int32).reshape((n, n))
        elif edge_format in ("UPPER_ROW", "LOWER_COL"):
            for i in range(n):
                for j in range(i + 1, n):
                    dist[i, j] = dist[j, i] = int(round(explicit_weights[idx]))
                    idx += 1
        elif edge_format in ("LOWER_ROW", "UPPER_COL"):
            for i in range(n):
                for j in range(i):
                    dist[i, j] = dist[j, i] = int(round(explicit_weights[idx]))
                    idx += 1
        elif edge_format in ("UPPER_DIAG_ROW", "LOWER_DIAG_COL"):
            for i in range(n):
                for j in range(i, n):
                    dist[i, j] = dist[j, i] = int(round(explicit_weights[idx]))
                    idx += 1
        elif edge_format in ("LOWER_DIAG_ROW", "UPPER_DIAG_COL"):
            for i in range(n):
                for j in range(i + 1):
                    dist[i, j] = dist[j, i] = int(round(explicit_weights[idx]))
                    idx += 1

        np.fill_diagonal(dist, 0)
        if len(coords) == n:
            coords_arr = np.array(coords, dtype=np.float64)
        else:
            coords_arr = np.array(
                [(math.cos(2 * math.pi * i / n) * 100, math.sin(2 * math.pi * i / n) * 100) for i in range(n)],
                dtype=np.float64,
            )
        return name, edge_type, coords_arr, dist

    coords_arr = np.array(coords, dtype=np.float64)
    dx = coords_arr[:, 0:1] - coords_arr[:, 0:1].T
    dy = coords_arr[:, 1:2] - coords_arr[:, 1:2].T
    sq_dist = dx * dx + dy * dy

    if edge_type == "ATT":
        r = np.sqrt(sq_dist / 10.0)
        t = np.floor(r + 0.5).astype(np.int32)
        dist = np.where(t < r, t + 1, t).astype(np.int32)
    elif edge_type == "CEIL_2D":
        dist = np.ceil(np.sqrt(sq_dist)).astype(np.int32)
    elif edge_type == "MAN_2D":
        dist = np.floor(np.abs(dx) + np.abs(dy) + 0.5).astype(np.int32)
    elif edge_type == "MAX_2D":
        dist = np.maximum(np.floor(np.abs(dx) + 0.5), np.floor(np.abs(dy) + 0.5)).astype(np.int32)
    elif edge_type == "GEO":
        pi = 3.141592
        rrr = 6378.388
        deg = np.trunc(coords_arr)
        minutes = coords_arr - deg
        rad = pi * (deg + 5.0 * minutes / 3.0) / 180.0
        lat = rad[:, 0:1]
        lon = rad[:, 1:2]
        q1 = np.cos(lon - lon.T)
        q2 = np.cos(lat - lat.T)
        q3 = np.cos(lat + lat.T)
        arg = np.clip(0.5 * ((1.0 + q1) * q2 - (1.0 - q1) * q3), -1.0, 1.0)
        dist = (rrr * np.arccos(arg) + 1.0).astype(np.int32)
    else:
        dist = np.floor(np.sqrt(sq_dist) + 0.5).astype(np.int32)

    np.fill_diagonal(dist, 0)
    return name, edge_type, coords_arr, dist


def simulated_annealing_tsp(dist_matrix, alpha=0.995, t_min=1e-3, seed=42):
    start_time = time.perf_counter()
    random.seed(seed)
    n = dist_matrix.shape[0]
    dist_list = dist_matrix.tolist()

    tour = list(range(n))
    random.shuffle(tour)

    current_cost = sum(dist_list[tour[i]][tour[(i + 1) % n]] for i in range(n))
    best_tour = tour[:]
    best_cost = current_cost

    best_history = [best_cost]
    current_history = [current_cost]

    t = max(10.0, float(np.mean(dist_matrix)))
    iters_per_temp = max(500, 4 * n)

    while t > t_min:
        for _ in range(iters_per_temp):
            i = random.randint(0, n - 2)
            j = random.randint(i + 1, n - 1)
            if i == 0 and j == n - 1:
                continue

            a = tour[i - 1]
            b = tour[i]
            c = tour[j]
            d = tour[0] if j == n - 1 else tour[j + 1]

            delta = (dist_list[a][c] + dist_list[b][d]) - (dist_list[a][b] + dist_list[c][d])

            if delta <= 0 or random.random() < math.exp(-delta / t):
                tour[i : j + 1] = tour[i : j + 1][::-1]
                current_cost += delta
                if current_cost < best_cost:
                    best_cost = current_cost
                    best_tour = tour[:]

        best_history.append(best_cost)
        current_history.append(current_cost)
        t *= alpha

    elapsed = time.perf_counter() - start_time
    return best_tour, int(best_cost), best_history, current_history, elapsed


def draw_cost_history(best_history, current_history, dataset_name):
    """Biểu đồ 1: Quá trình hội tụ chi phí qua các bước hạ nhiệt."""
    x_list = np.arange(1, len(best_history) + 1)
    plt.figure(figsize=(8, 4.5))
    plt.plot(x_list, current_history, alpha=0.4, lw=1.0, label="Current Cost")
    plt.plot(x_list, best_history, lw=1.8, label="Best Cost")
    plt.title(f"Route Cost through Temperature Steps ({dataset_name})")
    plt.xlabel("Temperature Steps")
    plt.ylabel("Cost")
    plt.legend()
    plt.grid(True, linestyle="--", alpha=0.5)
    plt.show()


def draw_path(coords, tour, best_cost, dataset_name):
    """Biểu đồ 2: Vẽ lộ trình tốt nhất tìm được trên mặt phẳng tọa độ."""
    closed_tour = list(tour) + [tour[0]]
    x_list = coords[closed_tour, 0]
    y_list = coords[closed_tour, 1]

    fig, ax = plt.subplots(figsize=(8, 6))
    plt.scatter(x_list, y_list, s=18)
    ax.plot(x_list, y_list, "--", lw=1.2, color="black")
    plt.title(f"Best SA Tour - {dataset_name} (Cost: {best_cost})")
    plt.xlabel("X")
    plt.ylabel("Y")
    plt.grid(True, linestyle="--", alpha=0.4)
    plt.show()


if __name__ == "__main__":
    name, edge_type, coords, dist_matrix = build_universal_data(TSP_DATA)
    best_tour, best_cost, best_hist, curr_hist, run_time = simulated_annealing_tsp(dist_matrix)

    print(f"Dataset: {name} | Số đỉnh: {dist_matrix.shape[0]} | Chuẩn: {edge_type}")
    print(f"Chi phí tốt nhất (Simulated Annealing): {best_cost}")
    print(f"Thời gian chạy: {run_time:.4f}s")
    print(f"Lộ trình (1-indexed): {[x + 1 for x in best_tour]}")

    draw_cost_history(best_hist, curr_hist, name)
    draw_path(coords, best_tour, best_cost, name)
